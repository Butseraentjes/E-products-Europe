<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Elke 5 minuten de nieuwe zakelijke aanvragen van e-productseurope.com naar Zendesk
     (scripts/aanvragen-ophalen.mjs). Geïnstalleerd 23 okt 2026 (Peters ja):
       cp launchd/be.e-productseurope.aanvragen.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/be.e-productseurope.aanvragen.plist
     Stoppen: launchctl unload ~/Library/LaunchAgents/be.e-productseurope.aanvragen.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>be.e-productseurope.aanvragen</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>--env-file=/Users/peterbutseraen/Projects/SEO-WOOD/.env</string>
    <string>/Users/peterbutseraen/Projects/e-products-europe/scripts/aanvragen-ophalen.mjs</string>
    <string>--confirm</string>
  </array>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/peterbutseraen/Projects/e-products-europe/logs/aanvragen.log</string>
  <key>StandardErrorPath</key><string>/Users/peterbutseraen/Projects/e-products-europe/logs/aanvragen-fout.log</string>
</dict>
</plist>
